# Job Finder API Environment Configuration
# Copy this file to .env and fill in your actual values

# API Settings
APP_NAME=Job Finder API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# BrightData Configuration
# Get your API key from: https://brightdata.com
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_LINKEDIN_ENDPOINT=https://api.brightdata.com/datasets/v3/trigger
BRIGHTDATA_GLASSDOOR_ENDPOINT=https://api.brightdata.com/datasets/v3/trigger
# Optional: Specify custom dataset IDs
BRIGHTDATA_DATASET_ID_LINKEDIN=
BRIGHTDATA_DATASET_ID_GLASSDOOR=

# Groq LLM Configuration
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3

# LangChain Configuration (Optional - for tracing)
LANGCHAIN_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-finder-api

# Performance & Rate Limiting
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=60
CACHE_TTL=3600

# Job Search Configuration
DEFAULT_JOB_LIMIT=10
MAX_JOB_LIMIT=50
MIN_MATCH_SCORE=60.0

# Scraping Configuration
SCRAPING_RETRY_ATTEMPTS=3
SCRAPING_RETRY_DELAY=2